        {
          "name": "Create task validation error",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"\",\n  \"priority\": \"urgent\"\n}" },
            "url": "{{baseUrl}}/api/tasks"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status is 400', function () { pm.response.to.have.status(400); });"]
              }
            }
          ]
        },
        {
          "name": "Create task on someone else's project",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{otherToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Should fail\",\n  \"projectId\": {{projectId}},\n  \"priority\": \"high\"\n}"
            },
            "url": "{{baseUrl}}/api/tasks"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status is 404', function () { pm.response.to.have.status(404); });"]
              }
            }
          ]
        },
        {
          "name": "Create high todo task",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Write liner notes\",\n  \"description\": \"Short bio and credits\",\n  \"status\": \"todo\",\n  \"priority\": \"high\",\n  \"projectId\": {{projectId}},\n  \"dueDate\": \"2026-11-01T00:00:00.000Z\"\n}"
            },
            "url": "{{baseUrl}}/api/tasks"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
                  "const task = pm.response.json().data;",
                  "pm.test('task is linked to the project and owner', function () {",
                  "  pm.expect(task.projectId).to.eql(Number(pm.collectionVariables.get('projectId')));",
                  "  pm.expect(task.priority).to.eql('high');",
                  "  pm.expect(task.ownerId).to.be.a('number');",
                  "});",
                  "pm.collectionVariables.set('taskId', task.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create low completed task",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Archive stems\",\n  \"status\": \"completed\",\n  \"priority\": \"low\",\n  \"projectId\": {{projectId}}\n}"
            },
            "url": "{{baseUrl}}/api/tasks"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status is 201', function () { pm.response.to.have.status(201); });"]
              }
            }
          ]
        },
        {
          "name": "List tasks",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/tasks?page=1&limit=10"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('pagination is present', function () {",
                  "  pm.expect(body.pagination.totalRecords).to.be.at.least(2);",
                  "  pm.expect(body.pagination.totalPages).to.be.at.least(1);",
                  "  pm.expect(body.pagination.page).to.eql(1);",
                  "  pm.expect(body.pagination.limit).to.eql(10);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter high todo tasks",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/tasks?page=1&limit=10&status=todo&priority=high&projectId={{projectId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('only high todo tasks are returned', function () {",
                  "  const tasks = pm.response.json().data;",
                  "  pm.expect(tasks.length).to.be.at.least(1);",
                  "  tasks.forEach(function (task) {",
                  "    pm.expect(task.status).to.eql('todo');",
                  "    pm.expect(task.priority).to.eql('high');",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        },
