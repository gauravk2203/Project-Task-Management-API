    {
      "name": "4. Dashboard and cleanup",
      "item": [
        {
          "name": "Dashboard",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/dashboard"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const stats = pm.response.json().data;",
                  "pm.test('stats include the created records', function () {",
                  "  pm.expect(stats.totalProjects).to.be.at.least(1);",
                  "  pm.expect(stats.completedProjects).to.be.at.least(1);",
                  "  pm.expect(stats.totalTasks).to.be.at.least(2);",
                  "  pm.expect(stats.pendingTasks).to.be.at.least(1);",
                  "  pm.expect(stats.completedTasks).to.be.at.least(1);",
                  "  pm.expect(stats.highPriorityTasks).to.be.at.least(1);",
                  "});"
                ]
              }
            }
          ]
        },
