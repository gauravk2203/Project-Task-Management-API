PORT=3000
NODE_ENV=development

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=project_task_db

MONGODB_URI=mongodb://127.0.0.1:27017/project_task_db

